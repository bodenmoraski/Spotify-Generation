# Required for the recommended two-pass ranker. Leave blank to use the
# heuristic ranker (dry-run and tests still work).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: Semantic Scholar key raises the shared-pool rate limit.
S2_API_KEY=

# 32-char unguessable path token for the public GitHub Pages URL.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
PUBLISH_TOKEN=

# Alerts: ntfy.sh topic name (no URL). Example: brief-alerts-x7k2
NTFY_TOPIC=

# healthchecks.io ping URL (full URL, including the uuid).
HEALTHCHECK_URL=

BRIEF_TIMEZONE=Europe/Zurich

# Optional: local synced folder Studio reads (primary ingestion path).
# Example: /Users/you/Library/CloudStorage/Dropbox/BriefSync
BRIEF_SYNC_PATH=

# Optional: OpenAI TTS for the private-podcast MP3 fallback (~$0.02–0.03/brief).
OPENAI_API_KEY=

# Optional extra alert channels.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# GitHub Pages site user/org (used only to print the public URL in logs).
GITHUB_PAGES_HOST=
