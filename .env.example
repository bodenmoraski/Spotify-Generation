# Primary LLM (DeepSeek V4). Leave blank to fall back to Gemini, then heuristic.
# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Fallback LLM if DEEPSEEK_API_KEY is unset (Gemini AI Studio free tier).
GEMINI_API_KEY=

# Optional: Semantic Scholar key raises the shared-pool rate limit.
S2_API_KEY=

# 32-char unguessable path token for the public GitHub Pages URL.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
PUBLISH_TOKEN=

# Alerts: ntfy.sh topic name (no URL). Required. Pick a hard-to-guess name and
# subscribe on your phone: https://ntfy.sh/<topic>
NTFY_TOPIC=

# healthchecks.io ping URL (full URL, including the uuid).
HEALTHCHECK_URL=

# Default: New York (Eastern Time); change if you are elsewhere.
BRIEF_TIMEZONE=America/New_York

# Optional: local synced folder Studio reads (primary ingestion path).
# Example: /Users/you/Library/CloudStorage/Dropbox/BriefSync
BRIEF_SYNC_PATH=

# Optional: OpenAI TTS for the private-podcast MP3 (~$0.02–0.03/brief).
OPENAI_API_KEY=

# Spotify is not an API key. One-time: `save-to-spotify auth login`, then store
# STS_TOKEN_B64 and STS_DPOP_KEY_B64 as GitHub Actions secrets (see README).

# Optional extra alert channels.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# GitHub Pages origin used in RSS/log URLs (no trailing slash).
# Example: https://<user>.github.io/<repo>
GITHUB_PAGES_HOST=
